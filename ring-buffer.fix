// Provides a ring buffer implementation.
// 
// Ring buffer can be used as deque, with armortized O(1) complexity for push/pop operations at both ends (front and back).
module RingBuffer;

type RingBuffer a = struct { data : Array (Option a), start : I64, end : I64 };

// Create a new ring buffer from an array. 
// 
// Note: This takes O(n) since it copies the elements from the array into the ring buffer.
// 
// # Parameters
// - `arr`: The array to initialize the ring buffer with.
create : Array a -> RingBuffer a;
create = |arr| (
    RingBuffer { data : arr.map(some), start : 0, end : arr.get_size }
);

// Get the size of a ring buffer.
// 
// # Parameters
// - `rb`: The ring buffer to get the size of.
get_size : RingBuffer a -> I64;
get_size = |rb| (
    let e = rb.@end;
    let s = rb.@start;
    if e >= s {
        e - s
    } else {
        let n = rb.@data.get_size;
        n + e - s
    }
);

// Get the element at the specified index in the ring buffer.
//
// # Parameters
// - `i`: The index to get the element from.
// - `rb`: The ring buffer to get the element from.
@ : I64 -> RingBuffer a -> a;
@ = |i, rb| (
    let s = rb.@start;
    let n = rb.@data.get_size;
    let i = (i + s) % n;
    match rb.@data.@(i) {
        some(v) => v,
        none() => undefined("[RingBuffer::@] Index out of bounds!")
    }
);

// Set the element at the specified index in the ring buffer.
//
// # Parameters
// - `i`: The index to set the element at.
// - `v`: The value to set.
// - `rb`: The ring buffer to set the element in.
set : I64 -> a -> RingBuffer a -> RingBuffer a;
set = |i, v, rb| (
    let s = rb.@start;
    let n = rb.@data.get_size;
    let i = (i + s) % n;
    rb.mod_data(mod(i, |opt|
        match opt {
            some(_) => some(v),
            none() => undefined("[RingBuffer::set] Index out of bounds!")
        }
    ))
);

// Modify the element at the specified index in the ring buffer.
//
// # Parameters
// - `i`: The index to modify the element at.
// - `f`: The function to apply to the element.
// - `rb`: The ring buffer to modify the element in.
mod : I64 -> (a -> a) -> RingBuffer a -> RingBuffer a;
mod = |i, f, rb| (
    let s = rb.@start;
    let n = rb.@data.get_size;
    let i = (i + s) % n;
    rb.mod_data(mod(i, |opt|
        match opt {
            some(v) => some(f(v)),
            none() => undefined("[RingBuffer::mod] Index out of bounds!")
        }
    ))
);

// Apply a functional action to the element at the specified index in the ring buffer.
//
// # Parameters
// - `i`: The index to apply the action to.
// - `f`: The functional action to apply to the element.
// - `rb`: The ring buffer to apply the action in.
act : [f : Functor] I64 -> (a -> f a) -> RingBuffer a -> f (RingBuffer a);
act = |i, f, rb| (
    let s = rb.@start;
    let n = rb.@data.get_size;
    let i = (i + s) % n;
    rb.act_data(act(i, |opt|
        match opt {
            some(v) => f(v).map(some),
            none() => undefined("[RingBuffer::act] Index out of bounds!")
        }
    ))
);

// Get the front element of the ring buffer.
//
// # Parameters
// - `rb`: The ring buffer to get the front element from.
get_front : RingBuffer a -> Option a;
get_front = |rb| (
    if rb.@start == rb.@end {
        none()
    } else {
        rb.@data.@(rb.@start)
    }
);

// Pop the front element from the ring buffer.
//
// # Parameters
// - `rb`: The ring buffer to pop the front element from.
pop_front : RingBuffer a -> RingBuffer a;
pop_front = |rb| (
    if rb.@start == rb.@end {
        // Buffer is empty
        rb
    } else {
        let s = rb.@start;
        let n = rb.@data.get_size;
        let rb = rb.mod_data(set(s, none()));
        let new_start = (s + 1) % n;
        rb.set_start(new_start)
    }
);

// Push a value to the front of the ring buffer.
//
// # Parameters
// - `v`: The value to push to the front.
// - `rb`: The ring buffer to push the value to the front of.
push_front : a -> RingBuffer a -> RingBuffer a;
push_front = |v, rb| (
    if rb.@start == rb.@end {
        // Buffer is empty and has no capacity
        rb
    } else {
        let s = rb.@start;
        let n = rb.@data.get_size;
        let new_start = (s - 1 + n) % n;
        let rb = rb.mod_data(set(new_start, some(v)));
        rb.set_start(new_start)
    }
);

// Get the back element of the ring buffer.
//
// # Parameters
// - `rb`: The ring buffer to get the back element from.
get_back : RingBuffer a -> Option a;
get_back = |rb| (
    if rb.@start == rb.@end {
        none()
    } else {
        let e = rb.@end;
        let n = rb.@data.get_size;
        let back_index = (e - 1 + n) % n;
        rb.@data.@(back_index)
    }
);

// Pop the back element from the ring buffer.
// 
// # Parameters
// - `rb`: The ring buffer to pop the back element from.
pop_back : RingBuffer a -> RingBuffer a;
pop_back = |rb| (
    if rb.@start == rb.@end {
        // Buffer is empty
        rb
    } else {
        let e = rb.@end;
        let n = rb.@data.get_size;
        let rb = rb.mod_data(set(e - 1, none()));
        let new_end = (e - 1 + n) % n;
        rb.set_end(new_end)
    }
);

// Double the size of the buffer
_realloc : RingBuffer a -> RingBuffer a;
_realloc = |rb| (
    let s = rb.@start;
    let n = rb.@data.get_size;
    let new_data = Array::fill(n * 2, none());
    let new_data = loop((s, 0, new_data), |(p, i, new_data)|
        if i == n { break $ new_data };
        let new_data = new_data.set(i, rb.@data.@(p));
        let p = (p + 1) % n;
        let i = i + 1;
        continue $ (p, i, new_data)
    );
    RingBuffer { data : new_data, start : 0, end : n }
);